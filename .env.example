# Copy to .env.local for local development. Only PUBLIC values belong here.
# Every VITE_ variable is compiled into the website and visible to anyone.
# NEVER put the Stripe secret key, Supabase service_role key, webhook secrets
# or KYC provider credentials in this file. Those live in Supabase secrets.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
VITE_SITE_URL=http://localhost:5173
